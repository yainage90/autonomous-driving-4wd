<?xml version="1.0"?>
<package format="3">
  <name>vehicle_simulation</name>
  <version>0.0.1</version>
  <description>Simulation and mock interfaces for the 4WD vehicle.</description>
  <maintainer email="maintainer@example.com">vehicle_team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>vehicle_interfaces</depend>

  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_actuator_sim</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>vehicle_actuator_sim</test_depend>
  <test_depend>vehicle_control</test_depend>
  <test_depend>ros_gz_bridge</test_depend>
  <test_depend>xacro</test_depend>

  <test_depend>python3-yaml</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>tf2_ros_py</test_depend>

  <export><build_type>ament_python</build_type></export>
</package>
