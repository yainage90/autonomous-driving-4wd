<?xml version="1.0"?>
<sdf version="1.9">
  <world name="evaluation">

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- GPU 라이다 등 렌더링 기반 센서를 실행 -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 윗면이 z=0인 바닥 -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>

      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <box>
              <size>8 6 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <box>
              <size>8 6 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 평가 공간의 +y 방향 외벽 -->
    <model name="north_wall">
      <static>true</static>
      <pose>0 2 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- -y 방향 외벽 -->
    <model name="south_wall">
      <static>true</static>
      <pose>0 -2 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>6 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- -x 방향 외벽 -->
    <model name="west_all">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 4.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 4.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- x 방향 외벽 -->
    <model name="east_wall">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 4.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 4.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="detour_obstacle">
      <static>true</static>
      <pose>0 0 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.6 1.2 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.6 1.2 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.1 1</ambient>
            <diffuse>0.9 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="closed_south_wall">
      <static>true</static>
      <pose>2 0.6 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>1.3 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>1.3 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="closed_north_wall">
      <static>true</static>
      <pose>2 1.6 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>1.3 0.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>1.3 0.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="closed_west_wall">
      <static>true</static>
      <pose>1.4 1.1 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 1.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 1.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="closed_east_wall">
      <static>true</static>
      <pose>2.6 1.1 0.5 0 0 0</pose>

      <link name="wall_link">
        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.1 1.1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.1 1.1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>