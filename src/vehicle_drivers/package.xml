<?xml version="1.0"?>
<package format="3">
  <name>vehicle_drivers</name>
  <version>0.0.1</version>
  <description>Hardware drivers for vehicle actuators and sensors.</description>
  <maintainer email="maintainer@example.com">vehicle_team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>vehicle_description</exec_depend>
  <exec_depend>vehicle_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>vehicle_localization</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
