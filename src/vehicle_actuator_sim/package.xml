<?xml version="1.0"?>
<package format="3">
  <name>vehicle_actuator_sim</name>
  <version>0.0.1</version>
  <description>Gazebo wheel actuator with a receiver-owned steady-clock watchdog.</description>
  <maintainer email="maintainer@example.com">vehicle_team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>vehicle_interfaces</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
