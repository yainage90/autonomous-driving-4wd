<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="2" name="navigate_with_recovery">
      <PipelineSequence name="navigate_with_replanning">
        <RateController hz="1.0">
          <ComputePathToPose
            goal="{goal}"
            path="{path}"
            planner_id="grid_based"
            error_code_id="{compute_path_error_code}"/>
        </RateController>

        <FollowPath
          path="{path}"
          controller_id="follow_path"
          goal_checker_id="goal_checker"
          error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>

      <Wait wait_duration="3.0"/>
    </RecoveryNode>
  </BehaviorTree>
</root>