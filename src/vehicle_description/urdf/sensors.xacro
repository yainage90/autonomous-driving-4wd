<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 9축 IMU 모듈 -->
  <xacro:macro name="imu" params="parent x y z">
    <link name="imu_link">
      <!-- 링크 원점은 장착면, 형상 중심은 그보다 4 mm 위 -->
      <visual>
        <origin xyz="0 0 0.004" rpy="0 0 0"/>
        <geometry>
          <box size="0.028 0.020 0.008"/>
        </geometry>
        <material name="imu_blue">
          <color rgba="0.10 0.25 0.75 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.004" rpy="0 0 0"/>
        <geometry>
          <box size="0.028 0.020 0.008"/>
        </geometry>
      </collision>

      <!-- 균일한 직육면체로 근사한 질량과 관성 -->
      <inertial>
        <origin xyz="0 0 0.004" rpy="0 0 0"/>
        <mass value="0.010"/>
        <inertia
          ixx="3.86667e-7" ixy="0" ixz="0"
          iyy="7.06667e-7" iyz="0"
          izz="9.86667e-7"/>
      </inertial>
    </link>

    <!-- IMU를 지정한 부모 링크에 고정 -->
    <joint name="imu_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

    <!-- RPLIDAR C1: 지름 55.6 mm, 높이 41.3 mm로 단순화 -->
  <xacro:macro name="lidar" params="parent x y z">
    <link name="laser_frame">
      <!-- 링크 원점은 스캔 평면, 본체 중심은 그보다 아래 -->
      <visual>
        <origin xyz="0 0 -0.01935" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0278" length="0.0413"/>
        </geometry>
        <material name="lidar_dark_gray">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 -0.01935" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.0278" length="0.0413"/>
        </geometry>
      </collision>

      <!-- 균일한 원통으로 근사: 질량 110 g -->
      <inertial>
        <origin xyz="0 0 -0.01935" rpy="0 0 0"/>
        <mass value="0.110"/>
        <inertia
          ixx="3.68886e-5" ixy="0" ixz="0"
          iyy="3.68886e-5" iyz="0"
          izz="4.25062e-5"/>
      </inertial>
    </link>

    <!-- 스캔 기준 좌표계를 차체에 고정 -->
    <joint name="lidar_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="laser_frame"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- 2축 팬·틸트 카메라 -->
  <xacro:macro name="camera" params="parent x y z">

    <!-- Figure-2 매립 설치. z는 상판 윗면.
         scratch/camera_2dof_ptz_dimensions.png: 상판 위 62 mm, 아래 16 mm.
         scratch/camera_servo_dimensions.png: 서보 몸체 23 × 12 × 23.2 mm.
         전체 높이는 도면에 맞추되, 브래킷 형상과 축/렌즈 위치는 근사값이다.
         상판 개구부는 섀시의 단순 박스 형상에 아직 표현하지 않는다. -->
    <xacro:property name="camera_above_plate" value="0.062"/>
    <xacro:property name="camera_insertion_depth" value="0.016"/>
    <xacro:property name="camera_servo_height" value="0.0232"/>
    <xacro:property name="camera_pan_height" value="${camera_servo_height - camera_insertion_depth}"/>
    <xacro:property name="camera_bracket_height" value="${camera_above_plate - camera_pan_height - 0.029}"/>

    <!-- 고정된 팬 서보 몸체: 상판 아래 16 mm부터 위 7.2 mm까지 -->
    <link name="camera_mount_link">
      <visual>
        <origin xyz="0 0 ${camera_servo_height / 2 - camera_insertion_depth}" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.012 ${camera_servo_height}"/>
        </geometry>
        <material name="camera_base_gray">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 ${camera_servo_height / 2 - camera_insertion_depth}" rpy="0 0 0"/>
        <geometry>
          <box size="0.023 0.012 ${camera_servo_height}"/>
        </geometry>
      </collision>

      <!-- 임시 질량 20 g, 균일한 직육면체로 근사 -->
      <inertial>
        <origin xyz="0 0 ${camera_servo_height / 2 - camera_insertion_depth}" rpy="0 0 0"/>
        <mass value="0.020"/>
        <inertia
          ixx="${0.020 * (0.012**2 + camera_servo_height**2) / 12}" ixy="0" ixz="0"
          iyy="${0.020 * (0.023**2 + camera_servo_height**2) / 12}" iyz="0"
          izz="${0.020 * (0.023**2 + 0.012**2) / 12}"/>
      </inertial>
    </link>

    <!-- 상판에 카메라 장착 기준점을 고정 -->
    <joint name="camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_mount_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>

    <!-- 팬 회전부: 근사 브래킷 40 × 40 × 25.8 mm -->
    <link name="camera_pan_link">
      <visual>
        <origin xyz="0 0 ${camera_bracket_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.040 0.040 ${camera_bracket_height}"/>
        </geometry>
        <material name="camera_pan_gray">
          <color rgba="0.45 0.45 0.45 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 ${camera_bracket_height / 2}" rpy="0 0 0"/>
        <geometry>
          <box size="0.040 0.040 ${camera_bracket_height}"/>
        </geometry>
      </collision>

      <!-- 임시 질량 30 g, 균일한 직육면체로 근사 -->
      <inertial>
        <origin xyz="0 0 ${camera_bracket_height / 2}" rpy="0 0 0"/>
        <mass value="0.030"/>
        <inertia
          ixx="${0.030 * (0.040**2 + camera_bracket_height**2) / 12}" ixy="0" ixz="0"
          iyy="${0.030 * (0.040**2 + camera_bracket_height**2) / 12}" iyz="0"
          izz="8.0e-6"/>
      </inertial>
    </link>

    <!-- 팬 관절: 서보 몸체 상단(상판 위 7.2 mm)을 Z축 회전 기준으로 근사 -->
    <joint name="camera_pan_joint" type="revolute">
      <parent link="camera_mount_link"/>
      <child link="camera_pan_link"/>

      <origin xyz="0 0 ${camera_pan_height}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>

      <!-- 모델 작성용 임시 제한값: 실제 서보 사양 확인 후 수정 -->
      <limit
        lower="-1.5708"
        upper="1.5708"
        effort="0.5"
        velocity="1.0"/>
    </joint>

    <!-- 틸트 회전부와 카메라: 임시 형상 30 × 40 × 29 mm -->
    <link name="camera_tilt_link">
      <visual>
        <origin xyz="0 0 0.0145" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.040 0.029"/>
        </geometry>
        <material name="camera_body_black">
          <color rgba="0.08 0.08 0.08 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0.0145" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.040 0.029"/>
        </geometry>
      </collision>

      <!-- 임시 질량 40 g, 균일한 직육면체로 근사 -->
      <inertial>
        <origin xyz="0 0 0.0145" rpy="0 0 0"/>
        <mass value="0.040"/>
        <inertia
          ixx="8.13667e-6" ixy="0" ixz="0"
          iyy="5.80333e-6" iyz="0"
          izz="8.33333e-6"/>
      </inertial>
    </link>

    <!-- 틸트 관절: 전체 높이 62 mm에 맞춘 근사 위치(상판 위 33 mm)에서 Y축 회전 -->
    <joint name="camera_tilt_joint" type="revolute">
      <parent link="camera_pan_link"/>
      <child link="camera_tilt_link"/>

      <origin xyz="0 0 ${camera_bracket_height}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>

      <!-- 모델 작성용 임시 제한값: 실제 서보 사양 확인 후 수정 -->
      <limit
        lower="-1.5708"
        upper="1.5708"
        effort="0.5"
        velocity="1.0"/>
    </joint>

    <!-- 카메라 광학 기준 좌표계 -->
    <link name="camera_optical_frame"/>

    <!-- 렌즈 좌표계를 틸트 회전부에 고정: 중립 시 상판 위 47.5 mm (근사) -->
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_tilt_link"/>
      <child link="camera_optical_frame"/>

      <origin
        xyz="0.015 0 0.0145"
        rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

  </xacro:macro>

</robot>