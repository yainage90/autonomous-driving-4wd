<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- <wheel_separation>${wheel_separation}</wheel_separation> -->
      <!-- 양방향 회전 시험에서 odom이 실제 회전량을 약 1.57배 과대 추정하여
          DiffDrive 계산용 윤거를 보정한다. 실제 바퀴 배치는 유지한다.
          이 설정은 바퀴 속도 명령과 오도메트리 계산에 모두 영향을 주므로,
          보정 후 직선·양방향 회전·사각형 주행을 재검증해야 한다. -->
      <wheel_separation>${wheel_separation * wheel_separation_multiplier}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <tf_topic>/tf</tf_topic>
    </plugin>

    <!-- 바퀴 회전량과 독립적으로 실제 모델 자세를 발행한다.
         검증용 TF는 별도 토픽으로 분리하고 ROS /tf로 브리지하지 않는다. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>

      <odom_topic>/ground_truth/odom</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>

      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <gaussian_noise>0</gaussian_noise>
    </plugin>

  </gazebo>

  <!-- 시뮬레이션 라이다의 초기 측정 설정 -->
  <xacro:arg
    name="lidar_config_file"
    default="${xacro.abs_filename('../config/lidar.yaml')}" />
  <xacro:property
    name="lidar_config"
    value="${xacro.load_yaml('$(arg lidar_config_file)')['lidar']}" />

  <!-- 기존 라이다 링크에 측정 기능 연결 -->
  <gazebo reference="laser_frame">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>${lidar_config['update_rate_hz']}</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>laser_frame</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_config['horizontal_samples']}</samples>
            <resolution>1</resolution>
            <min_angle>${lidar_config['min_angle_rad']}</min_angle>
            <max_angle>${lidar_config['max_angle_rad']}</max_angle>
          </horizontal>

          <!-- 수평면 한 층을 측정하는 2D 라이다 -->
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>

        <range>
          <min>${lidar_config['min_range_m']}</min>
          <max>${lidar_config['max_range_m']}</max>
          <resolution>${lidar_config['range_resolution_m']}</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

</robot>
