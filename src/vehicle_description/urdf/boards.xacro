<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Raspberry Pi -->
  <xacro:macro name="raspberry_pi" params="parent x y z">
    <link name="rpi_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.085 0.056 0.020"/>
        </geometry>
        <material name="rpi_green">
          <color rgba="0.1 0.6 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.085 0.056 0.020"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.050"/>
        <inertia
          ixx="0.0000147" ixy="0" ixz="0"
          iyy="0.0000317" iyz="0"
          izz="0.0000431"/>
      </inertial>
    </link>

    <joint name="${parent}_to_rpi" type="fixed">
      <parent link="${parent}"/>
      <child link="rpi_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ESP32 Board (with Terminal Shield) -->
  <xacro:macro name="esp32_board" params="parent x y z">
    <link name="esp32_link">
      <!-- 터미널 쉴드 베이스: 78 x 52.5 x 15 mm -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.078 0.0525 0.015"/>
        </geometry>
        <material name="esp_shield_black">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.078 0.0525 0.015"/>
        </geometry>
      </collision>

      <!-- ESP32 WROOM 모듈: 25.5 x 18 x 3.1 mm -->
      <!-- 쉴드 상단 중앙 근처에 배치 (z = 쉴드두께 절반(7.5mm) + WROOM두께 절반(1.55mm) = 9.05mm) -->
      <visual>
        <origin xyz="0 0 0.00905" rpy="0 0 0"/>
        <geometry>
          <box size="0.0255 0.018 0.0031"/>
        </geometry>
        <material name="esp_silver">
          <color rgba="0.8 0.8 0.8 1.0"/>
        </material>
      </visual>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.040"/>
        <inertia
          ixx="0.0000099" ixy="0" ixz="0"
          iyy="0.0000210" iyz="0"
          izz="0.0000295"/>
      </inertial>
    </link>

    <joint name="${parent}_to_esp32" type="fixed">
      <parent link="${parent}"/>
      <child link="esp32_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
